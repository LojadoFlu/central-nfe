# === Central NF-e — variáveis do FRONTEND (públicas) ===
# Projeto Firebase DEDICADO (isolado do CRM). Preencha com os dados do
# projeto novo criado no console Firebase para a Central NF-e.
# NENHUM segredo (certificado/senha) entra aqui — só identificadores públicos.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Região das Cloud Functions (mantém padrão dos apps irmãos).
NEXT_PUBLIC_FUNCTIONS_REGION=southamerica-east1

# === Segredos do BACKEND (NUNCA aqui / nunca no Git) ===
# Certificado A1 (.pfx base64) e senha vão para o Google Secret Manager,
# gravados por CNPJ via a função `nfeCadastrarCertificado`. Ver docs/certificate-security.md
