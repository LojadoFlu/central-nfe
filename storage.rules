rules_version = '2';

// Central NF-e — Regras Storage.
// XMLs originais e DANFEs são gravados/atualizados SÓ pelo backend (Admin SDK).
// O cliente pode, no máximo, LER (download) documentos autenticado.
// O XML original nunca é apagado pela interface (sem delete no cliente).
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    // /nfe/{cnpj}/{ano}/{mes}/{chave}.xml  — XML original e derivados.
    match /nfe/{allPaths=**} {
      allow read: if isAuth();
      allow write, delete: if false; // só backend
    }

    // /cte/{cnpj}/{ano}/{mes}/{chave}.xml  — XML original dos CT-e (fretes).
    match /cte/{allPaths=**} {
      allow read: if isAuth();
      allow write, delete: if false; // só backend
    }

    // /nfse/{cnpj}/{ano}/{mes}/{chave}.xml — XML original das NFS-e (serviços).
    match /nfse/{allPaths=**} {
      allow read: if isAuth();
      allow write, delete: if false; // só backend
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
