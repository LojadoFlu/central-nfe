rules_version = '2';

// Central NF-e — Regras Firestore.
// Princípio (herdado do crm-flu): o CLIENTE nunca escreve dado fiscal.
// Toda escrita de negócio passa por Cloud Functions (Admin SDK, que ignora estas regras).
// Segredos (certificado) NUNCA são legíveis pelo cliente.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    // admin > fiscal/financeiro > consulta
    function hasRole(roles) {
      return isAuth() && role() in roles;
    }
    // Usuário liberado: papel legado OU perfil custom aprovado (claim status=ativo).
    function ativo() {
      return isAuth() && (
        role() in ['admin', 'fiscal', 'financeiro', 'consulta'] ||
        request.auth.token.status == 'ativo'
      );
    }

    // Perfil do próprio usuário (papel/permissões). Escrita só backend.
    match /nfe_users/{uid} {
      allow read: if isAuth() && (request.auth.uid == uid || hasRole(['admin']));
      allow write: if false;
    }

    // Perfis (roles) definidos pelo admin — leitura por qualquer autenticado
    // (o app carrega as permissões do perfil do usuário); escrita só backend.
    match /nfe_roles/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Empresas/CNPJs — leitura por qualquer autenticado; escrita só backend.
    match /nfe_companies/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Certificado: apenas METADADOS (validade, série, emissor). O .pfx/senha
    // vivem no Secret Manager, nunca aqui. Ainda assim, leitura restrita e
    // escrita bloqueada no cliente.
    match /nfe_certificates/{id} {
      allow read: if ativo();
      allow write: if false;
    }

    // Estado de sincronização (NSU) e logs de integração — leitura fiscal/admin.
    match /nfe_sync_state/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /nfe_sync_logs/{id} {
      allow read: if ativo();
      allow write: if false;
    }

    // Documentos fiscais e derivados — leitura por qualquer autenticado; escrita só backend.
    match /nfe_documents/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfe_items/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfe_installments/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfe_payments/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfe_events/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfe_manifestations/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /nfe_suppliers/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Acordos de renegociação com fornecedores — leitura por autenticado;
    // escrita só backend (admin/financeiro via callable).
    match /nfe_agreements/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Despesas fixas recorrentes (aluguel, luz, internet…) — leitura por
    // autenticado; escrita só backend (admin/financeiro via callable).
    match /nfe_fixed_expenses/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Despesas manuais (sem NF / extraordinárias) — leitura por autenticado;
    // escrita só backend (admin/financeiro via callable).
    match /manual_expenses/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Pedidos de compra e mapeamentos de coluna por fornecedor — leitura por
    // autenticado; escrita só backend (via callable).
    match /purchase_orders/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /supplier_maps/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // CT-e (fretes) — documentos, eventos, estado/logs de sync. Leitura por
    // autenticado (estado/logs restritos a fiscal/admin); escrita só backend.
    match /cte_documents/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /cte_events/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /cte_sync_state/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /cte_sync_logs/{id} {
      allow read: if ativo();
      allow write: if false;
    }

    // NFS-e Nacional (serviços) — mesmo padrão do CT-e.
    match /nfse_documents/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfse_events/{id} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /nfse_sync_state/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /nfse_sync_logs/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /nfe_alerts/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Auditoria — leitura só admin, escrita só backend.
    match /audit_logs/{id} {
      allow read: if hasRole(['admin']);
      allow write: if false;
    }

    // PDVnet — vendas, recebimentos, recebíveis de cartão, lojas, estado de sync.
    match /sales/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /sale_payments/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /card_receivables/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /pdv_stores/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /pdv_sync_state/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    // Banco — extrato importado (OFX). Leitura p/ ativos; escrita só backend.
    match /bank_transactions/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /bank_accounts/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    // Taxas de cartão (configuração) — leitura p/ ativos; escrita só backend.
    match /card_rates/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    match /card_settings/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    // Vendas manuais (lojas offline) — leitura p/ ativos; escrita só backend.
    match /manual_sales/{id} {
      allow read: if ativo();
      allow write: if false;
    }
    // Configurações gerais (inclui flag/baseUrl do PDVnet — sem segredos).
    match /configuracoes/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Comissões ────────────────────────────────────────────────────────────
    // Aqui trafega salário/piso: leitura mais restrita que o resto do app —
    // admin/financeiro, ou perfil custom que tenha o módulo "comissoes".
    // Escrita, como sempre, só backend.
    function podeComissoes() {
      return isAuth() && (
        role() in ['admin', 'financeiro'] ||
        (request.auth.token.status == 'ativo' &&
         request.auth.token.roleId != null &&
         get(/databases/$(database)/documents/nfe_roles/$(request.auth.token.roleId))
           .data.modulos.hasAny(['comissoes']))
      );
    }

    match /pdv_sellers/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_cargos/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_funcionarios/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_regras/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_metas/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_bonus/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_campanhas/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_indicadores/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_indicadores_atingidos/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_ajustes/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_apuracoes/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_fechamentos/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_estornos/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }
    match /com_config/{id} {
      allow read: if podeComissoes();
      allow write: if false;
    }

    // Fallback: nega tudo que não foi explicitamente liberado acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
